# Copy to .env.local for local development, or set these in Vercel's project
# Settings -> Environment Variables for a real deployment. See README.md's
# "Backend and database" section for what each one does and where to find it
# in the Supabase dashboard (Project Settings -> API).

# Server-only. Never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Safe to expose — the anon key has no RLS policies granting it anything
# (see supabase/schema.sql), and every actual read/write goes through the
# service role key above instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave unset (or "0") in production. Set to "1" only for a stakeholder
# walkthrough that also needs ?demo in the URL — see lib/metrics.ts.
NEXT_PUBLIC_ALLOW_DEMO=0

# Matching: apply supabase/010-matching-engine.sql first. Leave delivery off
# while reviewing recommendations. These values must remain server-only.
MATCHING_EMAIL_ENABLED=0
RESEND_WEBHOOK_SECRET=
RESEND_API_KEY=
MATCHING_FROM_EMAIL=
MATCHING_REPLY_TO=
MATCHING_SITE_URL=
MATCHING_WORKER_SECRET=
RESEND_WEBHOOK_SECRET=
