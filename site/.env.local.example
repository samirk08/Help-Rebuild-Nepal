# Copy to .env.local for local development, or set these in Vercel's project
# Settings -> Environment Variables for a real deployment. See README.md's
# "Backend and database" section for what each one does and where to find it
# in the Supabase dashboard (Project Settings -> API).

# Server-only. Never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Safe to expose — the anon key has no RLS policies granting it anything
# (see supabase/schema.sql), and every actual read/write goes through the
# service role key above instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave unset (or "0") in production. Set to "1" only for a stakeholder
# walkthrough that also needs ?demo in the URL — see lib/metrics.ts.
NEXT_PUBLIC_ALLOW_DEMO=0

# Optional. Signs the short-lived upload capability that lets the browser that
# just submitted a form attach files to that submission (lib/upload-tickets.ts).
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset, so uploads work without
# it. Set it to rotate upload tickets independently of the database key; doing
# so invalidates tickets already issued, which at worst means a person who is
# mid-upload retries their attachments.
UPLOAD_TICKET_SECRET=

# Matching: apply supabase/010-matching-engine.sql first. Leave delivery off
# while reviewing recommendations. These values must remain server-only.
MATCHING_EMAIL_ENABLED=0
RESEND_API_KEY=
MATCHING_FROM_EMAIL=info@helprebuildnepal.com
MATCHING_REPLY_TO=
MATCHING_SITE_URL=
MATCHING_WORKER_SECRET=
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Deployment identity and the staging mail guard. See docs/RELEASE.md.
# ---------------------------------------------------------------------------

# Which deployment this is. On Vercel this is unnecessary — VERCEL_ENV already
# says. Set it explicitly anywhere else. An unlabelled deployment is treated as
# development, never production, because guessing the other way would switch
# the guard below off on a box nobody configured.
HRN_ENV=

# Outside production, mail is only ever delivered to these addresses. Everything
# else is cancelled in the outbox with the reason recorded.
#
# This exists because a staging pilot has to send real email to be a real test,
# so MATCHING_EMAIL_ENABLED gets set there — and at that moment a deployment
# pointed at a copy of production data can invite a real volunteer to work that
# does not exist.
#
# Comma-separated. An entry is a whole address or an "@domain" suffix. Empty
# means nothing is delivered at all, which is the safe direction to be wrong in.
MATCHING_TEST_RECIPIENTS=
